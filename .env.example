# Spotify for Creators (ex-Anchor) RSS feed. Leave unset to build with sample
# episode data — every page still renders, just with placeholder episodes.
PODCAST_RSS_URL=
PODCAST_SPOTIFY_URL=
PODCAST_APPLE_URL=

# Google Analytics measurement ID (e.g. G-XXXXXXXXXX). Leave unset to skip
# loading gtag.js entirely — see src/layouts/Layout.astro and /legal.
PUBLIC_GA_ID=
