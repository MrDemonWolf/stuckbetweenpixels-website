---
import LogoMark from "../assets/brand/logo-mark.svg";
import LogoMarkDark from "../assets/brand/logo-mark-dark.svg";
import { url } from "../lib/url";
import ThemeToggle from "./ThemeToggle.astro";

const links = [
	{ to: "/", label: "Home" },
	{ to: "/episodes", label: "Episodes" },
	{ to: "/about", label: "About" },
];
---

<header class="sticky top-0 z-30 border-b border-border bg-bg/85 backdrop-blur">
  <div class="mx-auto flex max-w-5xl items-center justify-between px-4 py-4 md:px-8">
    <a href={url("/")} class="flex items-center gap-2.5">
      {/* The mark's linework is ink on paper and bone on charcoal — swap the
         variant rather than letting one of them vanish into the background. */}
      <img src={LogoMark.src} alt="" class="h-9 w-auto dark:hidden" />
      <img src={LogoMarkDark.src} alt="" class="hidden h-9 w-auto dark:block" />
      <span class="display-tight text-lg">Stuck Between Pixels</span>
    </a>
    <div class="flex items-center gap-6">
      <nav class="kicker flex gap-6 text-fg-muted">
        {
          links.map((link) => (
            <a href={url(link.to)} class="transition-colors hover:text-ember">
              {link.label}
            </a>
          ))
        }
      </nav>
      <ThemeToggle />
    </div>
  </div>
</header>
