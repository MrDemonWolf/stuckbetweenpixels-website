---
import LogoMark from "../assets/brand/logo-mark.svg";
import LogoMarkDark from "../assets/brand/logo-mark-dark.svg";
import ThemeToggle from "./ThemeToggle.astro";

const links = [
	{ to: "/", label: "Home" },
	{ to: "/episodes", label: "Episodes" },
	{ to: "/about", label: "About" },
];
---

<header class="border-b border-border">
  <div class="mx-auto flex max-w-5xl items-center justify-between px-4 py-5 md:px-8">
    <a href="/" class="flex items-center gap-2">
      {/* Dark mode gets a light-outline variant — the mark's dark-violet edge
         nearly disappears against the near-black page background otherwise. */}
      <img src={LogoMark.src} alt="Stuck Between Pixels" class="h-8 w-auto dark:hidden" />
      <img
        src={LogoMarkDark.src}
        alt="Stuck Between Pixels"
        class="hidden h-8 w-auto dark:block"
      />
      <span class="font-display text-lg font-medium">Stuck Between Pixels</span>
    </a>
    <div class="flex items-center gap-6">
      <nav class="eyebrow flex gap-6 text-fg-muted">
        {
          links.map((link) => (
            <a href={link.to} class="transition-colors hover:text-accent">
              {link.label}
            </a>
          ))
        }
      </nav>
      <ThemeToggle />
    </div>
  </div>
</header>
