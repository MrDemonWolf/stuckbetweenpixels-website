---
interface Props {
	spotifyEpisodeId?: string;
	audioUrl?: string;
}

const { spotifyEpisodeId, audioUrl } = Astro.props;
---

<div class="rounded-2xl border border-border bg-surface p-4">
  {
    spotifyEpisodeId ? (
      // Spotify's embed always renders dark — the surrounding panel carries the
      // theme instead of the iframe itself.
      <iframe
        title="Spotify episode player"
        style="border-radius:12px"
        src={`https://open.spotify.com/embed/episode/${spotifyEpisodeId}`}
        width="100%"
        height="152"
        allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
        loading="lazy"
      />
    ) : audioUrl ? (
      <audio controls class="w-full" src={audioUrl} />
    ) : (
      <p class="text-sm text-fg-muted">Listen on Spotify once the episode is live.</p>
    )
  }
</div>
