---
import type { CollectionEntry } from "astro:content";
import LogoMark from "../assets/brand/logo-mark-dark.svg";
import {
	artworkFor,
	audioUrlFor,
	durationFor,
	episodeNumberFor,
	formatDate,
	hasArtworkFor,
	slugFor,
} from "../lib/episodes";

interface Props {
	entry: CollectionEntry<"episodes">;
}

const { entry } = Astro.props;
const data = entry.data as Record<string, unknown>;
const number = episodeNumberFor(entry);
const duration = durationFor(entry);
const audioUrl = audioUrlFor(entry);
const hasArtwork = hasArtworkFor(entry);

import { url } from "../lib/url";
---

<section class="mx-auto max-w-5xl px-4 py-16 md:px-8">
  <p class="eyebrow text-fg-muted">Latest episode</p>
  <div class="mt-4 grid items-center gap-8 md:grid-cols-[1fr_1.4fr]">
    <div class="relative">
      <div class="absolute -inset-4 -z-10 rounded-[1.5rem] bg-brand-strong"></div>
      {
        hasArtwork ? (
          <img
            src={artworkFor(entry)}
            alt=""
            width="480"
            height="480"
            class="aspect-square w-full rounded-xl object-cover shadow-card"
          />
        ) : (
          <div class="grid aspect-square w-full place-items-center rounded-xl bg-brand-strong shadow-card">
            <img src={LogoMark.src} alt="" class="w-2/5" />
          </div>
        )
      }
      <p
        class="pointer-events-none absolute -top-6 -left-4 font-display text-6xl font-medium text-brand-strong opacity-15 select-none md:text-8xl"
        style="-webkit-text-stroke: 2px var(--color-on-brand); color: transparent;"
        aria-hidden="true"
      >
        {number ? `EP.${String(number).padStart(2, "0")}` : "EP."}
      </p>
    </div>

    <div>
      <a href={url(`/episodes/${slugFor(entry)}`)}>
        <h2 class="font-display text-2xl font-medium transition-colors hover:text-brand md:text-3xl">
          {data.title as string}
        </h2>
      </a>
      <p class="eyebrow mt-2 text-fg-muted">
        {formatDate(data.pubDate)}
        {duration && <span> &middot; {duration}</span>}
      </p>
      <p class="mt-4 max-w-lg text-fg-muted">{data.description as string}</p>

      <div class="mt-6 flex flex-wrap items-center gap-4">
        {
          audioUrl ? (
            <button
              type="button"
              data-play-episode
              data-episode-id={entry.id}
              data-title={data.title as string}
              data-audio-url={audioUrl}
              data-artwork={artworkFor(entry)}
              class="eyebrow inline-flex items-center gap-2 rounded-full bg-brand px-5 py-2.5 text-bg transition-opacity hover:opacity-90"
            >
              <svg class="size-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M8 5v14l11-7Z" />
              </svg>
              Play episode
            </button>
          ) : (
            <a
              href={url(`/episodes/${slugFor(entry)}`)}
              class="eyebrow inline-flex items-center gap-2 rounded-full bg-brand px-5 py-2.5 text-bg transition-opacity hover:opacity-90"
            >
              Listen
            </a>
          )
        }
        <a href={url(`/episodes/${slugFor(entry)}`)} class="text-sm text-brand hover:underline">
          Show notes &rarr;
        </a>
      </div>
    </div>
  </div>
</section>
