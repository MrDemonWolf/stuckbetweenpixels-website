---
import type { CollectionEntry } from "astro:content";
import LogoMarkDark from "../assets/brand/logo-mark-dark.svg";
import {
	artworkFor,
	audioUrlFor,
	durationFor,
	episodeNumberFor,
	formatDate,
	hasArtworkFor,
	slugFor,
	tagsFor,
} from "../lib/episodes";
import { url } from "../lib/url";

interface Props {
	entry: CollectionEntry<"episodes">;
	kicker?: string;
	/** Reverses the columns so Start Here and Latest don't mirror each other. */
	flip?: boolean;
}

const { entry, kicker = "Latest episode", flip = false } = Astro.props;
const data = entry.data as Record<string, unknown>;
const number = episodeNumberFor(entry);
const duration = durationFor(entry);
const audioUrl = audioUrlFor(entry);
const tags = tagsFor(entry);
---

<div class="reveal grid items-center gap-10 md:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)]">
  <div class:list={["relative", flip && "md:order-2"]}>
    {/* Numeral breaks outside the artwork column — the grid-break moment. */}
    <p
      class="display pointer-events-none absolute -top-8 -left-4 z-10 text-6xl text-transparent select-none md:-top-12 md:-left-10 md:text-8xl"
      style="-webkit-text-stroke: 2px var(--color-ember);"
      aria-hidden="true"
    >
      {number ? `EP.${String(number).padStart(2, "0")}` : "EP."}
    </p>

    {
      hasArtworkFor(entry) ? (
        <img
          src={artworkFor(entry)}
          alt=""
          width="520"
          height="520"
          class="aspect-square w-full rounded-2xl border border-border object-cover shadow-card"
        />
      ) : (
        <div class="grid aspect-square w-full place-items-center rounded-2xl border border-border bg-surface shadow-card">
          <img src={LogoMarkDark.src} alt="" class="w-1/2" />
        </div>
      )
    }
  </div>

  <div>
    <p class="kicker text-ember">{kicker}</p>

    <h2 class="display-tight mt-3 text-3xl text-balance md:text-4xl">
      <a href={url(`/episodes/${slugFor(entry)}`)} class="transition-colors hover:text-ember">
        {data.title as string}
      </a>
    </h2>

    <p class="kicker mt-3 flex flex-wrap items-center gap-x-3 text-fg-muted">
      <span>{formatDate(data.pubDate)}</span>
      {duration && <span class="text-border-strong">/</span>}
      {duration && <span>{duration}</span>}
    </p>

    <p class="mt-5 max-w-lg text-fg-muted">{data.description as string}</p>

    {
      tags.length > 0 && (
        <ul class="mt-4 flex flex-wrap gap-2">
          {tags.map((tag) => (
            <li class="kicker rounded-full border border-border px-3 py-1 text-[0.65rem] text-fg-muted">
              {tag}
            </li>
          ))}
        </ul>
      )
    }

    <div class="mt-7 flex flex-wrap items-center gap-5">
      {
        audioUrl ? (
          <button
            type="button"
            data-play-episode
            data-episode-id={entry.id}
            data-title={data.title as string}
            data-audio-url={audioUrl}
            data-artwork={artworkFor(entry)}
            class="kicker inline-flex min-h-11 items-center gap-2 rounded-full bg-ember px-6 text-on-ember transition-opacity hover:opacity-90"
          >
            <svg class="size-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M8 5v14l11-7Z" />
            </svg>
            Play episode
          </button>
        ) : (
          <a
            href={url(`/episodes/${slugFor(entry)}`)}
            class="kicker inline-flex min-h-11 items-center gap-2 rounded-full bg-ember px-6 text-on-ember transition-opacity hover:opacity-90"
          >
            Listen
          </a>
        )
      }
      <a
        href={url(`/episodes/${slugFor(entry)}`)}
        class="kicker inline-flex min-h-11 items-center text-fg-muted underline-offset-4 transition-colors hover:text-ember hover:underline"
      >
        Show notes &rarr;
      </a>
    </div>
  </div>
</div>
