---
// Persistent bottom playback bar. Any element with [data-play-episode] on any
// page can start it — see the data-* contract read below.
//
// transition:persist MUST live on this root element, not on <StickyPlayer /> in
// Layout.astro: the directive only applies to a component with a single root
// node, and this component also emits a <script>. Put it on the component and
// Astro silently emits nothing, so the audio element is torn down on every
// navigation.
---

<div
  id="sticky-player"
  transition:persist="sticky-player"
  class="fixed inset-x-0 bottom-0 z-20 hidden translate-y-full border-t border-border bg-surface/90 backdrop-blur transition-transform data-[open]:flex data-[open]:translate-y-0"
>
  <div class="mx-auto flex w-full max-w-5xl items-center gap-4 px-4 py-3 md:px-8">
    <img id="sp-artwork" alt="" width="40" height="40" class="size-10 shrink-0 rounded-lg object-cover" />

    <button
      id="sp-toggle"
      type="button"
      aria-label="Play"
      class="grid size-9 shrink-0 place-items-center rounded-full bg-ember text-bg"
    >
      <svg id="sp-icon-play" class="size-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M8 5v14l11-7Z" />
      </svg>
      <svg id="sp-icon-pause" class="hidden size-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M6 5h4v14H6zM14 5h4v14h-4z" />
      </svg>
    </button>

    <button
      id="sp-back"
      type="button"
      aria-label="Back 15 seconds"
      class="hidden shrink-0 text-fg-muted transition-colors hover:text-ember sm:block"
    >
      <span class="kicker">-15</span>
    </button>

    <div class="min-w-0 flex-1">
      <p id="sp-title" class="truncate text-sm font-medium">&nbsp;</p>
      <div class="mt-1 flex items-center gap-2">
        <span id="sp-elapsed" class="font-mono text-xs text-fg-muted tabular-nums">0:00</span>
        <div id="sp-scrubber" class="relative h-6 flex-1 cursor-pointer">
          <div id="sp-bars" class="absolute inset-0 flex items-center gap-px"></div>
        </div>
        <span id="sp-duration" class="font-mono text-xs text-fg-muted tabular-nums">0:00</span>
      </div>
    </div>

    <button
      id="sp-forward"
      type="button"
      aria-label="Forward 15 seconds"
      class="hidden shrink-0 text-fg-muted transition-colors hover:text-ember sm:block"
    >
      <span class="kicker">+15</span>
    </button>

    <button
      id="sp-speed"
      type="button"
      aria-label="Playback speed"
      class="kicker hidden w-10 shrink-0 rounded-full border border-border py-1 text-center text-fg-muted transition-colors hover:border-ember hover:text-ember sm:block"
    >
      1&times;
    </button>

    <button id="sp-close" type="button" aria-label="Close player" class="shrink-0 text-fg-muted hover:text-ember">
      <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M6 6l12 12M18 6L6 18" />
      </svg>
    </button>
  </div>

  <audio id="sp-audio"></audio>
</div>

<script>
  import { url } from "../lib/url";
  import { waveformHeights } from "../lib/waveform";

  const SPEEDS = [1, 1.25, 1.5, 2];
  const FALLBACK_ARTWORK = url("/favicon.png");

  const root = document.getElementById("sticky-player") as HTMLDivElement;
  const audio = document.getElementById("sp-audio") as HTMLAudioElement;
  const toggle = document.getElementById("sp-toggle") as HTMLButtonElement;
  const iconPlay = document.getElementById("sp-icon-play") as unknown as SVGElement;
  const iconPause = document.getElementById("sp-icon-pause") as unknown as SVGElement;
  const title = document.getElementById("sp-title") as HTMLParagraphElement;
  const artwork = document.getElementById("sp-artwork") as HTMLImageElement;
  const elapsedEl = document.getElementById("sp-elapsed") as HTMLSpanElement;
  const durationEl = document.getElementById("sp-duration") as HTMLSpanElement;
  const bars = document.getElementById("sp-bars") as HTMLDivElement;
  const scrubber = document.getElementById("sp-scrubber") as HTMLDivElement;
  const speedBtn = document.getElementById("sp-speed") as HTMLButtonElement;
  const closeBtn = document.getElementById("sp-close") as HTMLButtonElement;
  const backBtn = document.getElementById("sp-back") as HTMLButtonElement;
  const forwardBtn = document.getElementById("sp-forward") as HTMLButtonElement;

  function fmt(seconds: number) {
    if (!Number.isFinite(seconds)) return "0:00";
    const m = Math.floor(seconds / 60);
    const s = Math.floor(seconds % 60);
    return `${m}:${String(s).padStart(2, "0")}`;
  }

  function paintWaveform(seed: string, progress: number) {
    const heights = waveformHeights(seed);
    bars.innerHTML = "";
    heights.forEach((pct, i) => {
      const bar = document.createElement("span");
      const played = i / heights.length < progress;
      bar.className = `w-[3px] rounded-full ${played ? "bg-ember" : "bg-border"}`;
      bar.style.height = `${pct}%`;
      bars.appendChild(bar);
    });
  }

  let currentId = "";
  let speedIndex = 0;

  function setPlayingIcon(playing: boolean) {
    iconPlay.classList.toggle("hidden", playing);
    iconPause.classList.toggle("hidden", !playing);
    toggle.setAttribute("aria-label", playing ? "Pause" : "Play");
  }

  function load(detail: { id: string; title: string; audioUrl: string; artwork?: string }) {
    currentId = detail.id;
    title.textContent = detail.title;
    artwork.src = detail.artwork ?? FALLBACK_ARTWORK;
    audio.src = detail.audioUrl;
    audio.playbackRate = SPEEDS[speedIndex];
    root.dataset.open = "";
    audio.play().catch(() => {});
    paintWaveform(detail.id, 0);
  }

  document.addEventListener("click", (e) => {
    const btn = (e.target as HTMLElement)?.closest<HTMLElement>("[data-play-episode]");
    if (!btn) return;
    e.preventDefault();
    const id = btn.dataset.episodeId ?? "";
    if (id === currentId && !audio.paused) {
      audio.pause();
      return;
    }
    if (id === currentId) {
      audio.play().catch(() => {});
      return;
    }
    load({
      id,
      title: btn.dataset.title ?? "",
      audioUrl: btn.dataset.audioUrl ?? "",
      artwork: btn.dataset.artwork,
    });
  });

  toggle.addEventListener("click", () => {
    if (audio.paused) audio.play().catch(() => {});
    else audio.pause();
  });
  audio.addEventListener("play", () => setPlayingIcon(true));
  audio.addEventListener("pause", () => setPlayingIcon(false));

  backBtn.addEventListener("click", () => {
    audio.currentTime = Math.max(0, audio.currentTime - 15);
  });
  forwardBtn.addEventListener("click", () => {
    audio.currentTime = Math.min(audio.duration || Infinity, audio.currentTime + 15);
  });

  speedBtn.addEventListener("click", () => {
    speedIndex = (speedIndex + 1) % SPEEDS.length;
    audio.playbackRate = SPEEDS[speedIndex];
    speedBtn.textContent = `${SPEEDS[speedIndex]}×`;
  });

  closeBtn.addEventListener("click", () => {
    audio.pause();
    root.removeAttribute("data-open");
  });

  audio.addEventListener("timeupdate", () => {
    elapsedEl.textContent = fmt(audio.currentTime);
    if (audio.duration) paintWaveform(currentId, audio.currentTime / audio.duration);
  });
  audio.addEventListener("loadedmetadata", () => {
    durationEl.textContent = fmt(audio.duration);
  });

  scrubber.addEventListener("click", (e) => {
    if (!audio.duration) return;
    const rect = scrubber.getBoundingClientRect();
    const pct = Math.min(1, Math.max(0, (e.clientX - rect.left) / rect.width));
    audio.currentTime = pct * audio.duration;
  });

  // Re-sync icon/labels after an astro:transitions swap (this element itself
  // persists via transition:persist, but header/page content around it doesn't).
  document.addEventListener("astro:page-load", () => {
    setPlayingIcon(!audio.paused);
  });
</script>
