---
import { Image } from "astro:assets";
import { hosts } from "../data/hosts";
import { url } from "../lib/url";
---

<div class="grid gap-6 sm:grid-cols-2">
  {
    hosts.map((host) => (
      <a
        href={url(`/about#${host.slug}`)}
        class="group flex items-center gap-4 rounded-2xl border border-border bg-surface p-4 transition-colors hover:border-ember"
      >
        <Image
          src={host.photo}
          alt={host.name}
          width={56}
          height={56}
          class="size-14 shrink-0 rounded-full object-cover"
        />
        <div class="min-w-0">
          <p class="display-tight text-lg leading-tight group-hover:text-ember">{host.name}</p>
          <p class="kicker mt-1 truncate text-fg-muted">{host.role}</p>
        </div>
      </a>
    ))
  }
</div>
