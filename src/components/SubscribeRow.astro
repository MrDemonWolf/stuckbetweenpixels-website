---
import spotifyLogo from "../assets/brand/platforms/spotify.svg";
import { url } from "../lib/url";

// ponytail: real Apple/Spotify show URLs go here once the show is live on both.
const links = [
	{
		label: "Spotify",
		href: import.meta.env.PODCAST_SPOTIFY_URL || "https://open.spotify.com",
		icon: "spotify",
	},
	{
		label: "Apple Podcasts",
		href: import.meta.env.PODCAST_APPLE_URL || "https://podcasts.apple.com",
		icon: "apple",
	},
	{ label: "RSS", href: url("/rss.xml"), icon: "rss" },
] as const;
---

<div class="flex flex-wrap gap-3">
  {
    links.map((link) => (
      <a
        href={link.href}
        class="kicker inline-flex items-center gap-2 rounded-full border border-border px-4 py-2 text-fg transition-colors hover:border-ember hover:text-ember"
      >
        {/* Official Spotify mark in its brand green, which their guidelines
           require (green, black, or white only — no recolouring). */}
        {link.icon === "spotify" && (
          <img src={spotifyLogo.src} alt="" class="size-4 shrink-0" />
        )}
        {/* Deliberately a generic microphone, not Apple's mark. Apple's identity
           guidelines require their supplied badge artwork and forbid drawing
           your own — see "Apple Podcasts badge" in README.md. */}
        {link.icon === "apple" && (
          <svg class="size-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 3a3 3 0 0 1 3 3v5a3 3 0 0 1-6 0V6a3 3 0 0 1 3-3Z" />
            <path d="M6 10.5a.9.9 0 0 1 1.8 0 4.2 4.2 0 0 0 8.4 0 .9.9 0 1 1 1.8 0 6 6 0 0 1-5.1 5.93V19h2.4a.9.9 0 0 1 0 1.8H8.7a.9.9 0 0 1 0-1.8h2.4v-2.57A6 6 0 0 1 6 10.5Z" />
          </svg>
        )}
        {link.icon === "rss" && (
          <svg class="size-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <circle cx="5.5" cy="18.5" r="2" />
            <path d="M4 10a10 10 0 0 1 10 10h-2.5A7.5 7.5 0 0 0 4 12.5Zm0-5.5a15.5 15.5 0 0 1 15.5 15.5H17A13 13 0 0 0 4 7Z" />
          </svg>
        )}
        {link.label}
      </a>
    ))
  }
</div>
