---
import type { CollectionEntry } from "astro:content";
import { totalRuntimeHours } from "../lib/episodes";

interface Props {
	entries: CollectionEntry<"episodes">[];
	class?: string;
}

const { entries, class: className = "" } = Astro.props;
const hours = totalRuntimeHours(entries);

const stats = [
	// Before launch there are no episodes — "00 Episodes" reads as broken, so
	// lead with the launch state instead.
	entries.length === 0
		? { value: "Soon", label: "First episode" }
		: {
				value: String(entries.length).padStart(2, "0"),
				label: entries.length === 1 ? "Episode" : "Episodes",
			},
	// Hide runtime until there's at least an hour — "0 hrs" reads as broken.
	...(hours > 0
		? [{ value: `${hours}`, label: hours === 1 ? "Hour" : "Hours" }]
		: []),
	{ value: "2", label: "Hosts" },
	{ value: "Bi-wk", label: "Cadence" },
];
---

{/* A 2x2 grid on phones: flex-wrap orphaned the last item onto its own row
   while it kept the divider rule, which read as a misaligned stray. The
   dividers only make sense once the stats sit on one line. */}
<dl class:list={["grid grid-cols-2 gap-x-8 gap-y-5 sm:flex sm:items-stretch sm:gap-0", className]}>
  {
    stats.map((stat, i) => (
      <div
        class:list={[
          "flex flex-col justify-center sm:pr-6 md:pr-8",
          i > 0 && "sm:border-l sm:border-border sm:pl-6 md:pl-8",
        ]}
      >
        <dt class="kicker order-2 mt-1 text-fg-muted">{stat.label}</dt>
        <dd class="display-tight order-1 text-2xl md:text-3xl">{stat.value}</dd>
      </div>
    ))
  }
</dl>
