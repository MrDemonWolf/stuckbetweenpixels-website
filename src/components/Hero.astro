---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import hosts from "../assets/brand/hero-podcast-hosts.png";
import { hosts as hostData } from "../data/hosts";
import { url } from "../lib/url";
import StatsStrip from "./StatsStrip.astro";
import SubscribeRow from "./SubscribeRow.astro";

interface Props {
	entries: CollectionEntry<"episodes">[];
}

const { entries } = Astro.props;
---

<section class="relative overflow-hidden border-b border-border">
  <div
    class="mx-auto grid max-w-5xl items-center gap-12 px-4 pt-14 pb-16 md:grid-cols-[1.05fr_0.95fr] md:gap-8 md:px-8 md:pt-20 md:pb-24"
  >
    <div class="relative z-10 animate-hero-rise motion-reduce:animate-none">
      <p class="kicker flex items-center gap-2 text-ember">
        <span class="on-air-dot inline-block size-2 rounded-full bg-ember"></span>
        On air &middot; Web dev &middot; DevOps &middot; AI &middot; business
      </p>

      <h1 class="display mt-5 text-[length:var(--text-display)] text-balance">
        Code,<br />business,<br />
        <span class="text-ember">&amp; the network.</span>
      </h1>

      <p class="mt-6 max-w-md text-lg text-fg-muted">
        Nathanial Henniges and Stephan Moerman talk with industry experts about
        web development, DevOps, AI, and the business skills that actually move a
        tech career forward.
      </p>

      <div class="mt-8 flex flex-wrap items-center gap-4">
        <a
          href={url("/episodes")}
          class="kicker inline-flex min-h-11 items-center gap-2 rounded-full bg-ember px-5 text-on-ember transition-opacity hover:opacity-90"
        >
          <svg class="size-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M8 5v14l11-7Z" />
          </svg>
          Start listening
        </a>
        <a href={url("/about")} class="group flex min-h-11 items-center gap-3">
          <span class="flex -space-x-2">
            {
              hostData.map((host) => (
                <Image
                  src={host.photo}
                  alt={host.name}
                  width={32}
                  height={32}
                  densities={[1, 2]}
                  class="size-8 rounded-full border-2 border-bg object-cover"
                />
              ))
            }
          </span>
          <span class="kicker text-fg-muted transition-colors group-hover:text-ember">
            Meet the hosts
          </span>
        </a>
      </div>

      <StatsStrip entries={entries} class="mt-10 border-t border-border pt-6" />
    </div>

    {/* Bleeds off the right viewport edge on wide screens instead of sitting in
       a rounded box — the grid-break that stops the page reading as a column. */}
    <div
      class="relative animate-hero-rise motion-reduce:animate-none md:-mr-[max(0px,calc((100vw-64rem)/2))]"
      style="animation-delay: 120ms"
    >
      <div
        class="absolute -inset-4 -z-10 rounded-3xl bg-surface md:rounded-r-none md:rounded-l-3xl"
      >
      </div>
      <Image
        src={hosts}
        alt="The Stuck Between Pixels hosts recording an episode"
        width={720}
        class="w-full rounded-2xl md:rounded-r-none"
      />
    </div>
  </div>

  <div class="border-t border-border">
    <div class="mx-auto max-w-5xl px-4 py-5 md:px-8">
      <SubscribeRow />
    </div>
  </div>
</section>
