---
// Sun/moon toggle. Layout.astro's inline script resolves the initial data-theme
// before paint; this only handles the click + persists the explicit choice.
---

<button
  id="theme-toggle"
  type="button"
  aria-label="Toggle light and dark theme"
  aria-pressed="false"
  class="grid size-8 shrink-0 place-items-center rounded-full border border-border text-fg-muted transition-colors hover:border-accent hover:text-accent"
>
  <svg class="size-4 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
    <circle cx="12" cy="12" r="4" />
    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
  </svg>
  <svg class="hidden size-4 dark:block" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path d="M20.5 14.5a8.5 8.5 0 1 1-9-11 6.5 6.5 0 0 0 9 9Z" />
  </svg>
</button>

<script>
  const KEY = "sbp-theme";
  const root = document.documentElement;
  const btn = document.getElementById("theme-toggle");

  function apply(theme: string) {
    root.dataset.theme = theme;
    btn?.setAttribute("aria-pressed", String(theme === "dark"));
  }

  apply(root.dataset.theme ?? "dark");

  btn?.addEventListener("click", () => {
    const next = root.dataset.theme === "dark" ? "light" : "dark";
    localStorage.setItem(KEY, next);
    apply(next);
  });

  // No explicit choice yet — keep following the OS live.
  if (!localStorage.getItem(KEY)) {
    matchMedia("(prefers-color-scheme: dark)").addEventListener("change", (e) => {
      if (!localStorage.getItem(KEY)) apply(e.matches ? "dark" : "light");
    });
  }

  // astro:transitions swaps the DOM but not this inline handler's closure over
  // the old #theme-toggle node — re-run on every page load to rebind + resync.
  document.addEventListener("astro:page-load", () => apply(root.dataset.theme ?? "dark"));
</script>
