---
import LogoMark from "../assets/brand/logo-mark.svg";
import LogoMarkDark from "../assets/brand/logo-mark-dark.svg";
import SubscribeRow from "./SubscribeRow.astro";

interface Props {
	/** Shown on the episode archive, which has its own page heading already. */
	compact?: boolean;
}

const { compact = false } = Astro.props;
---

<div class="reveal flex flex-col items-center rounded-2xl border border-border bg-surface px-6 py-14 text-center md:py-20">
  <img src={LogoMark.src} alt="" class="w-20 dark:hidden" />
  <img src={LogoMarkDark.src} alt="" class="hidden w-20 dark:block" />

  <p class="kicker mt-6 flex items-center gap-2 text-ember">
    <span class="on-air-dot inline-block size-2 rounded-full bg-ember"></span>
    Recording now
  </p>

  <h2 class:list={["display mt-4", compact ? "text-2xl md:text-3xl" : "text-3xl md:text-5xl"]}>
    Episode one is coming
  </h2>

  <p class="mt-5 max-w-md text-fg-muted">
    We're in the studio putting the first episodes together. Follow the show
    now and the first one lands straight in your feed.
  </p>

  <div class="mt-8">
    <SubscribeRow />
  </div>
</div>
