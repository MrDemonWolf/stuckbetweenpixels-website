---
// Source for the social-share card. Screenshot this at exactly 1200x630 and
// save it over src/assets/brand/default-social-share.jpg — rendering it here
// means the card uses the real brand fonts and tokens instead of an
// approximation composed outside the design system.
// Excluded from the sitemap in astro.config.mjs and noindexed.
import { Image } from "astro:assets";
import hosts from "../assets/brand/hero-podcast-hosts.png";
import LogoMarkDark from "../assets/brand/logo-mark-dark.svg";
import "../styles/global.css";
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="robots" content="noindex, nofollow" />
    <title>OG template</title>
  </head>
  <body class="font-sans">
    <div
      id="og-card"
      class="relative overflow-hidden bg-bg"
      style="width: 1200px; height: 630px;"
    >
      {/* Art spans the full width so BOTH hosts are in frame; the text sits in
         a scrim across the bottom rather than a side panel, which covered the
         left host entirely. Biased upward to keep faces above the scrim. */}
      <Image
        src={hosts}
        alt=""
        width={1400}
        class="absolute inset-0 h-full w-full object-cover"
        style="object-position: 50% 12%;"
      />
      <div
        class="absolute inset-0"
        style="background: linear-gradient(to top, var(--color-bg) 0%, var(--color-bg) 30%, rgb(14 11 10 / 0.86) 44%, rgb(14 11 10 / 0.12) 68%);"
      >
      </div>

      <div class="absolute inset-x-0 bottom-0 z-10 flex items-end justify-between px-14 pb-11">
        <div>
          <div class="flex items-center gap-3">
            <img src={LogoMarkDark.src} alt="" class="h-11 w-auto" />
            <span class="kicker text-ember">Podcast</span>
          </div>

          <h1 class="display mt-4 text-[62px] leading-[0.95] text-fg">
            Stuck Between <span class="text-ember">Pixels</span>
          </h1>

          <p class="mt-4 max-w-xl text-[20px] leading-snug text-fg-muted">
            Web development, DevOps, and the business skills that actually move a
            tech career forward.
          </p>
        </div>

        <p class="kicker shrink-0 pb-2 text-fg-muted">stuckbetweenpixels.com</p>
      </div>
    </div>
  </body>
</html>
