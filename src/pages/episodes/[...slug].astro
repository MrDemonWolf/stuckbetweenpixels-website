---
import { getCollection } from "astro:content";
import HostStrip from "../../components/HostStrip.astro";
import Player from "../../components/Player.astro";
import Layout from "../../layouts/Layout.astro";
import {
	artworkFor,
	audioUrlFor,
	durationFor,
	episodeNumberFor,
	formatDate,
	hasArtworkFor,
	slugFor,
	tagsFor,
} from "../../lib/episodes";

export async function getStaticPaths() {
	const episodes = await getCollection("episodes");
	return episodes.map((entry) => ({
		params: { slug: slugFor(entry) },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const data = entry.data as Record<string, unknown>;
const duration = durationFor(entry);
const audioUrl = audioUrlFor(entry);
const number = episodeNumberFor(entry);
const tags = tagsFor(entry);

const site = Astro.site ?? new URL("https://stuckbetweenpixels.com");

// partOfSeries lets crawlers group episode pages back under the one show.
const schema = {
	"@context": "https://schema.org",
	"@type": "PodcastEpisode",
	name: data.title as string,
	description: data.description as string,
	datePublished: data.pubDate as string,
	url: new URL(`/episodes/${slugFor(entry)}/`, site).href,
	episodeNumber: episodeNumberFor(entry),
	partOfSeries: {
		"@type": "PodcastSeries",
		name: "Stuck Between Pixels",
		url: site.href,
		webFeed: new URL("/rss.xml", site).href,
	},
	...(audioUrl
		? { associatedMedia: { "@type": "AudioObject", contentUrl: audioUrl } }
		: {}),
};

import { url } from "../../lib/url";
---

<Layout
  title={`${data.title} — Stuck Between Pixels`}
  description={data.description as string}
  ogType="article"
  image={hasArtworkFor(entry) ? artworkFor(entry) : undefined}
  schema={schema}
>
  <header class="border-b border-border bg-surface">
    <div class="mx-auto max-w-3xl px-4 pt-14 pb-12 md:px-8 md:pt-20">
      <p class="kicker text-ember">
        {number ? `Episode ${String(number).padStart(2, "0")}` : "Episode"}
      </p>
      <h1 class="display-tight mt-4 text-3xl text-balance md:text-5xl">
        {data.title as string}
      </h1>
      <p class="kicker mt-5 flex flex-wrap items-center gap-x-3 text-fg-muted">
        <span>{formatDate(data.pubDate)}</span>
        {duration && <span class="text-border-strong">/</span>}
        {duration && <span>{duration}</span>}
      </p>
      {
        tags.length > 0 && (
          <ul class="mt-4 flex flex-wrap gap-2">
            {tags.map((tag) => (
              <li class="kicker rounded-full border border-border px-3 py-1 text-[0.65rem] text-fg-muted">
                {tag}
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </header>

  <article class="mx-auto max-w-3xl px-4 py-14 md:px-8">
    <div>
      <Player audioUrl={audioUrl} />
      {
        audioUrl && (
          <button
            type="button"
            data-play-episode
            data-episode-id={entry.id}
            data-title={data.title as string}
            data-audio-url={audioUrl}
            class="kicker mt-3 inline-flex items-center gap-2 rounded-full border border-border px-4 py-2 text-fg-muted transition-colors hover:border-ember hover:text-ember"
          >
            <svg class="size-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M8 5v14l11-7Z" />
            </svg>
            Play in sticky player
          </button>
        )
      }
    </div>

    <h2 class="kicker mt-12 text-ember">Show notes</h2>
    <p class="mt-4 text-lg whitespace-pre-line text-fg-muted">
      {data.description as string}
    </p>

    <div class="mt-14 border-t border-border pt-8">
      <p class="kicker text-fg-muted">Hosted by</p>
      <div class="mt-5">
        <HostStrip />
      </div>
    </div>

    <a
      href={url("/episodes")}
      class="kicker mt-10 inline-block text-ember underline-offset-4 hover:underline"
    >
      &larr; All episodes
    </a>
  </article>
</Layout>
