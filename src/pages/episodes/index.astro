---
import { getCollection } from "astro:content";
import EpisodeCard from "../../components/EpisodeCard.astro";
import Layout from "../../layouts/Layout.astro";
import { sortByDateDesc } from "../../lib/episodes";

const episodes = sortByDateDesc(await getCollection("episodes"));
---

<Layout title="Episodes — Stuck Between Pixels">
  <section class="mx-auto max-w-3xl px-4 py-16 md:px-8">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <h1 class="font-display text-4xl font-medium">Episodes</h1>
      <div class="flex items-center gap-3">
        <label class="sr-only" for="episode-search">Search episodes</label>
        <input
          id="episode-search"
          type="search"
          placeholder="Search episodes&hellip;"
          class="rounded-full border border-border bg-surface px-4 py-2 text-sm text-fg placeholder:text-fg-muted focus:border-accent focus:outline-none"
        />
        <select
          id="episode-sort"
          class="eyebrow rounded-full border border-border bg-surface px-3 py-2 text-fg-muted focus:border-accent focus:outline-none"
        >
          <option value="desc">Newest</option>
          <option value="asc">Oldest</option>
        </select>
      </div>
    </div>

    <div id="episode-list" class="mt-10">
      {
        episodes.map((entry, i) => (
          <div data-episode-row data-title={(entry.data as Record<string, unknown>).title}>
            <EpisodeCard entry={entry} index={episodes.length - i} />
          </div>
        ))
      }
    </div>
    <p id="episode-empty" class="hidden py-12 text-center text-fg-muted">
      No episodes match "<span id="episode-empty-query"></span>".
    </p>
  </section>
</Layout>

<script>
  const search = document.getElementById("episode-search") as HTMLInputElement;
  const sort = document.getElementById("episode-sort") as HTMLSelectElement;
  const list = document.getElementById("episode-list") as HTMLDivElement;
  const empty = document.getElementById("episode-empty") as HTMLParagraphElement;
  const emptyQuery = document.getElementById("episode-empty-query") as HTMLSpanElement;

  // Server renders newest-first — that's the one true order rows come in.
  const rowsDesc = Array.from(list.querySelectorAll<HTMLDivElement>("[data-episode-row]"));

  function apply() {
    const query = search.value.trim().toLowerCase();
    const rows = sort.value === "asc" ? [...rowsDesc].reverse() : rowsDesc;
    let visible = 0;

    for (const row of rows) {
      const match = (row.dataset.title ?? "").toLowerCase().includes(query);
      row.classList.toggle("hidden", !match);
      if (match) visible++;
      list.appendChild(row);
    }

    empty.classList.toggle("hidden", visible !== 0);
    emptyQuery.textContent = search.value;
  }

  search.addEventListener("input", apply);
  sort.addEventListener("change", apply);
</script>
