---
import { getCollection } from "astro:content";
import ComingSoon from "../../components/ComingSoon.astro";
import EpisodeCard from "../../components/EpisodeCard.astro";
import StatsStrip from "../../components/StatsStrip.astro";
import Layout from "../../layouts/Layout.astro";
import {
	allTags,
	groupByYear,
	sortByDateDesc,
	tagsFor,
} from "../../lib/episodes";

const episodes = sortByDateDesc(await getCollection("episodes"));
const years = groupByYear(episodes);
const tags = allTags(episodes);

// Episode numbers count down from the newest so the label is stable regardless
// of how the client-side filter reorders rows.
const numberFor = new Map(episodes.map((e, i) => [e.id, episodes.length - i]));
---

<Layout
  title="All Episodes — Stuck Between Pixels"
  description="Browse every episode of Stuck Between Pixels. Conversations on web development, DevOps, WordPress, and the business side of building software."
>
  <section class="border-b border-border">
    <div class="mx-auto max-w-5xl px-4 pt-14 pb-10 md:px-8 md:pt-20">
      <p class="kicker text-ember">The archive</p>
      <h1 class="display mt-4 text-5xl md:text-7xl">Episodes</h1>
      <StatsStrip entries={episodes} class="mt-8 border-t border-border pt-6" />
    </div>
  </section>

  {
    episodes.length === 0 && (
      <div class="mx-auto max-w-3xl px-4 py-16 md:px-8">
        <ComingSoon compact />
      </div>
    )
  }

  {/* Full-width so the sticky background spans the viewport instead of
     painting a rectangle that stops at the container edge. */}
  <div
    class:list={[
      // Only sticky from sm up: on a phone the wrapped filter row is ~180px
      // tall, which together with the sticky header would pin a third of the
      // viewport permanently.
      "z-20 border-b border-border bg-bg/90 backdrop-blur sm:sticky sm:top-[4.25rem]",
      episodes.length === 0 && "hidden",
    ]}
  >
    <div class="mx-auto flex max-w-5xl flex-wrap items-center gap-3 px-4 py-4 md:px-8">
      <label class="sr-only" for="episode-search">Search episodes</label>
      <input
        id="episode-search"
        type="search"
        placeholder="Search episodes&hellip;"
        class="min-w-0 flex-1 rounded-full border border-border bg-surface px-4 py-2 text-sm text-fg placeholder:text-fg-muted"
      />

      {
        tags.length > 0 && (
          <div class="flex flex-wrap gap-2" role="group" aria-label="Filter by topic">
            <button
              type="button"
              data-tag=""
              aria-pressed="true"
              class="tag-filter kicker rounded-full border border-ember bg-ember px-3 py-1.5 text-on-ember"
            >
              All
            </button>
            {tags.map((tag) => (
              <button
                type="button"
                data-tag={tag}
                aria-pressed="false"
                class="tag-filter kicker rounded-full border border-border px-3 py-1.5 text-fg-muted transition-colors hover:border-ember hover:text-ember"
              >
                {tag}
              </button>
            ))}
          </div>
        )
      }

      <label class="sr-only" for="episode-sort">Sort episodes</label>
      <select
        id="episode-sort"
        class="kicker rounded-full border border-border bg-surface px-3 py-2 text-fg-muted"
      >
        <option value="desc">Newest</option>
        <option value="asc">Oldest</option>
      </select>
    </div>
  </div>

  <div class="mx-auto max-w-5xl px-4 md:px-8">
    <div id="episode-list" class="pb-16">
      {
        years.map(([year, yearEpisodes]) => (
          <section data-year-group={year}>
            <h2 class="display mt-12 mb-2 text-2xl text-fg-muted first:mt-8">{year}</h2>
            {yearEpisodes.map((entry) => (
              <div
                data-episode-row
                data-title={(entry.data as Record<string, unknown>).title}
                data-tags={tagsFor(entry).join("|")}
              >
                <EpisodeCard entry={entry} index={numberFor.get(entry.id)} />
              </div>
            ))}
          </section>
        ))
      }
    </div>

    <p id="episode-empty" class="hidden pb-16 text-center text-fg-muted">
      No episodes match that search.
    </p>
  </div>
</Layout>

<script>
  function initArchive() {
    const search = document.getElementById("episode-search") as HTMLInputElement | null;
    const sort = document.getElementById("episode-sort") as HTMLSelectElement | null;
    const list = document.getElementById("episode-list");
    const empty = document.getElementById("episode-empty");
    if (!search || !sort || !list || !empty) return;

    const groups = Array.from(list.querySelectorAll<HTMLElement>("[data-year-group]"));
    const filters = Array.from(document.querySelectorAll<HTMLButtonElement>(".tag-filter"));
    // Server order is newest-first; keep it as the reference for re-sorting.
    const rowsByGroup = new Map(
      groups.map((g) => [g, Array.from(g.querySelectorAll<HTMLElement>("[data-episode-row]"))]),
    );
    let activeTag = "";

    function apply() {
      const query = search!.value.trim().toLowerCase();
      const asc = sort!.value === "asc";
      let visible = 0;

      const ordered = asc ? [...groups].reverse() : groups;
      for (const group of ordered) {
        const rows = rowsByGroup.get(group) ?? [];
        let groupVisible = 0;

        for (const row of asc ? [...rows].reverse() : rows) {
          const title = (row.dataset.title ?? "").toLowerCase();
          const tags = (row.dataset.tags ?? "").split("|").filter(Boolean);
          const match =
            title.includes(query) && (activeTag === "" || tags.includes(activeTag));
          row.classList.toggle("hidden", !match);
          if (match) groupVisible++;
          group.appendChild(row);
        }

        // Hide the year header when nothing under it survived the filter.
        group.classList.toggle("hidden", groupVisible === 0);
        visible += groupVisible;
        list!.appendChild(group);
      }

      empty!.classList.toggle("hidden", visible !== 0);
    }

    for (const btn of filters) {
      btn.addEventListener("click", () => {
        activeTag = btn.dataset.tag ?? "";
        for (const other of filters) {
          const on = other === btn;
          other.setAttribute("aria-pressed", String(on));
          other.classList.toggle("bg-ember", on);
          other.classList.toggle("border-ember", on);
          other.classList.toggle("text-on-ember", on);
          other.classList.toggle("border-border", !on);
          other.classList.toggle("text-fg-muted", !on);
        }
        apply();
      });
    }

    search.addEventListener("input", apply);
    sort.addEventListener("change", apply);
  }

  initArchive();
  document.addEventListener("astro:page-load", initArchive);
</script>
