---
import Layout from "../layouts/Layout.astro";
import { url } from "../lib/url";
---

<Layout
  title="Page not found — Stuck Between Pixels"
  description="That page doesn't exist. Head back to the show."
  noindex
>
  <section class="mx-auto max-w-2xl px-4 py-24 text-center md:px-6">
    <h1 class="display-tight text-4xl">404</h1>
    <p class="mt-4 text-fg-muted">That page doesn't exist.</p>
    <a href={url("/")} class="mt-6 inline-block text-ember hover:underline">
      &larr; Back home
    </a>
  </section>
</Layout>
