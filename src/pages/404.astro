---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Page not found — Stuck Between Pixels">
  <section class="mx-auto max-w-2xl px-4 py-24 text-center md:px-6">
    <h1 class="font-display text-4xl">404</h1>
    <p class="mt-4 text-fg-muted">That page doesn't exist.</p>
    <a href="/" class="mt-6 inline-block text-brand hover:underline">
      &larr; Back home
    </a>
  </section>
</Layout>
