---
import { Image } from "astro:assets";
import Section from "../components/Section.astro";
import SubscribeRow from "../components/SubscribeRow.astro";
import { hosts } from "../data/hosts";
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="About — Stuck Between Pixels"
  description="Who we are and why we started Stuck Between Pixels — a podcast about web development, DevOps, and the business of building."
>
  <section class="border-b border-border">
    <div class="mx-auto max-w-5xl px-4 pt-14 pb-16 md:px-8 md:pt-20">
      <p class="kicker text-ember">About the show</p>
      <h1 class="display mt-4 max-w-3xl text-4xl text-balance md:text-6xl">
        Conversations for people who build things
      </h1>
      <p class="mt-8 max-w-2xl text-lg text-fg-muted">
        Stuck Between Pixels explores the dynamic world of technology, with a focus on
        web development, DevOps, business development, and professional networking.
        Each episode features conversations with industry experts, covering current
        trends and best practices &mdash; CI/CD, cloud computing, product management,
        marketing, and building the kind of professional network that actually helps
        you grow. Whether you're a developer, tech enthusiast, or entrepreneur, it's
        built to help you excel and make meaningful connections in the digital world.
      </p>
    </div>
  </section>

  <Section kicker="Your hosts" heading="Two builders, one mic each" width="wide">
    <div class="space-y-16 md:space-y-24">
      {
        hosts.map((host, i) => (
          <article
            id={host.slug}
            class="reveal grid scroll-mt-28 items-start gap-8 md:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)] md:gap-12"
          >
            {/* Alternate sides so the page reads as a spread, not a stack. */}
            <div class:list={["relative", i % 2 === 1 && "md:order-2"]}>
              <div class="absolute -inset-3 -z-10 rounded-3xl bg-surface" />
              <Image
                src={host.photo}
                alt={host.name}
                width={420}
                height={420}
                class="aspect-square w-full rounded-2xl border border-border object-cover"
              />
            </div>

            <div>
              <h3 class="display-tight text-2xl md:text-3xl">{host.name}</h3>
              <p class="kicker mt-2 text-ember">{host.role}</p>
              <p class="mt-5 text-lg text-fg-muted">{host.bio}</p>
              <div class="mt-6 flex flex-wrap gap-3">
                {host.links.map((link) => (
                  <a
                    href={link.href}
                    class="kicker rounded-full border border-border px-4 py-2 text-fg-muted transition-colors hover:border-ember hover:text-ember"
                  >
                    {link.label}
                  </a>
                ))}
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </Section>

  <Section variant="ink" kicker="Subscribe" heading="Listen wherever you get podcasts" width="wide">
    <SubscribeRow />
  </Section>
</Layout>
