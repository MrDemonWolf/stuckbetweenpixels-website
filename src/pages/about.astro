---
import { Image } from "astro:assets";
import Section from "../components/Section.astro";
import SubscribeRow from "../components/SubscribeRow.astro";
import { hosts } from "../data/hosts";
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="About — Stuck Between Pixels"
  description="Meet Nathanial Henniges and Stephan Moerman, the developers behind Stuck Between Pixels, and find out why they started the show."
>
  <section class="border-b border-border">
    <div class="mx-auto max-w-5xl px-4 pt-14 pb-16 md:px-8 md:pt-20">
      <p class="kicker text-ember">About the show</p>
      <h1 class="display mt-4 max-w-3xl text-3xl text-balance sm:text-4xl md:text-6xl">
        Conversations for people who build things
      </h1>
      <p class="mt-8 max-w-2xl text-lg text-fg-muted">
        Two developers talking shop with people who do this for a living. Episodes
        cover the building part, so web development, DevOps, cloud and CI/CD, and
        where AI actually fits into all of it. Then the part nobody warns you
        about: product management, marketing, and working out which professional
        connections are worth having.
      </p>
      <p class="mt-5 max-w-2xl text-lg text-fg-muted">
        Useful whether you write the code, run the company, or are stuck doing both.
      </p>
    </div>
  </section>

  <Section kicker="Your hosts" heading="Two builders, one mic each" width="wide">
    <div class="space-y-16 md:space-y-24">
      {
        hosts.map((host, i) => (
          <article
            id={host.slug}
            class:list={[
              "reveal grid scroll-mt-28 items-start gap-8 md:gap-12",
              // Alternate sides so the page reads as a spread, not a stack.
              // The portrait column is a fixed 240px (a fractional column grew it
              // to ~340px and dwarfed the bio), so the template has to flip too —
              // `order` alone would swap which element gets the narrow column and
              // squeeze the bio into 240px.
              i % 2 === 1
                ? "md:grid-cols-[minmax(0,1fr)_minmax(0,240px)]"
                : "md:grid-cols-[minmax(0,240px)_minmax(0,1fr)]",
            ]}
          >
            <div
              class:list={[
                "relative max-w-[240px]",
                i % 2 === 1 && "md:col-start-2 md:row-start-1",
              ]}
            >
              <div class="absolute -inset-3 -z-10 rounded-3xl bg-surface"></div>
              <Image
                src={host.photo}
                alt={host.name}
                width={240}
                height={240}
                densities={[1, 2]}
                class="aspect-square w-full rounded-2xl border border-border object-cover"
              />
            </div>

            <div class:list={[i % 2 === 1 && "md:col-start-1 md:row-start-1"]}>
              <h3 class="display-tight text-2xl md:text-3xl">{host.name}</h3>
              <p class="kicker mt-2 text-ember">{host.role}</p>
              <p class="mt-5 text-lg text-fg-muted">{host.bio}</p>
              <div class="mt-6 flex flex-wrap gap-3">
                {host.links.map((link) => (
                  <a
                    href={link.href}
                    class="kicker inline-flex min-h-11 items-center rounded-full border border-border px-4 text-fg-muted transition-colors hover:border-ember hover:text-ember"
                  >
                    {link.label}
                  </a>
                ))}
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </Section>

  <Section variant="ink" kicker="Subscribe" heading="Listen wherever you get podcasts" width="wide">
    <SubscribeRow />
  </Section>
</Layout>
