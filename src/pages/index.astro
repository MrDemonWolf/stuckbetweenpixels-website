---
import { getCollection } from "astro:content";
import EpisodeCard from "../components/EpisodeCard.astro";
import FeaturedEpisode from "../components/FeaturedEpisode.astro";
import Hero from "../components/Hero.astro";
import HostStrip from "../components/HostStrip.astro";
import SubscribeRow from "../components/SubscribeRow.astro";
import { hosts } from "../data/hosts";
import Layout from "../layouts/Layout.astro";
import { sortByDateDesc } from "../lib/episodes";

const episodes = sortByDateDesc(await getCollection("episodes"));
const [latest, ...rest] = episodes;
const recent = rest.slice(0, 3);

const site = Astro.site ?? new URL("https://stuckbetweenpixels.com");

// PodcastSeries on the homepage ties the scattered episode pages into one show
// entity for search engines — directories read RSS, crawlers read this.
const schema = {
	"@context": "https://schema.org",
	"@type": "PodcastSeries",
	name: "Stuck Between Pixels",
	description:
		"A podcast about web development, DevOps, business development, and professional networking in tech.",
	url: site.href,
	webFeed: new URL("/rss.xml", site).href,
	author: hosts.map((host) => ({ "@type": "Person", name: host.name })),
};

import { url } from "../lib/url";
---

<Layout schema={schema}>
  <Hero />

  {latest && <FeaturedEpisode entry={latest} />}

  {
    recent.length > 0 && (
      <section class="mx-auto max-w-3xl px-4 py-16 md:px-8">
        <h2 class="eyebrow text-fg-muted">More episodes</h2>
        <div class="mt-2">
          {recent.map((entry, i) => (
            <EpisodeCard entry={entry} index={episodes.length - 1 - i} />
          ))}
        </div>
        <a href={url("/episodes")} class="mt-6 inline-block text-brand hover:underline">
          All episodes &rarr;
        </a>
      </section>
    )
  }

  <section class="mx-auto max-w-3xl px-4 py-16 md:px-8">
    <h2 class="eyebrow text-fg-muted">Hosted by</h2>
    <div class="mt-4">
      <HostStrip />
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-4 pb-16 md:px-8">
    <h2 class="eyebrow text-fg-muted">Listen wherever you get podcasts</h2>
    <div class="mt-4">
      <SubscribeRow />
    </div>
  </section>
</Layout>
