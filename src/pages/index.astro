---
import { getCollection } from "astro:content";
import ComingSoon from "../components/ComingSoon.astro";
import EpisodeCard from "../components/EpisodeCard.astro";
import FeaturedEpisode from "../components/FeaturedEpisode.astro";
import Hero from "../components/Hero.astro";
import HostStrip from "../components/HostStrip.astro";
import Section from "../components/Section.astro";
import { hosts } from "../data/hosts";
import Layout from "../layouts/Layout.astro";
import { sortByDateDesc, startHereFor } from "../lib/episodes";
import { url } from "../lib/url";

const episodes = sortByDateDesc(await getCollection("episodes"));
const [latest, ...rest] = episodes;
const recent = rest.slice(0, 3);

// The curated front door for new listeners. Hidden when it *is* the latest,
// since showing the same episode twice reads as a bug.
const startHere = startHereFor(episodes);
const showStartHere = startHere && startHere.id !== latest?.id;

const site = Astro.site ?? new URL("https://stuckbetweenpixels.com");

// PodcastSeries on the homepage ties the scattered episode pages into one show
// entity for search engines — directories read RSS, crawlers read this.
const schema = {
	"@context": "https://schema.org",
	"@type": "PodcastSeries",
	name: "Stuck Between Pixels",
	description:
		"A podcast about web development, DevOps, business development, and professional networking in tech.",
	url: site.href,
	webFeed: new URL("/rss.xml", site).href,
	author: hosts.map((host) => ({ "@type": "Person", name: host.name })),
};
---

<Layout
  title="Stuck Between Pixels — Web Dev, DevOps & Business Podcast"
  description="Nathanial Henniges and Stephan Moerman talk with industry experts about web development, DevOps, and the business skills that actually move a tech career forward. New episodes every other week."
  schema={schema}
>
  <Hero entries={episodes} />

  {
    episodes.length === 0 && (
      <Section width="wide">
        <ComingSoon />
      </Section>
    )
  }

  {
    latest && (
      <Section width="wide">
        <FeaturedEpisode entry={latest} kicker="Latest episode" />
      </Section>
    )
  }

  {
    showStartHere && (
      <Section variant="ink" width="wide">
        <FeaturedEpisode entry={startHere} kicker="New here? Start with this" flip />
      </Section>
    )
  }

  {
    recent.length > 0 && (
      <Section kicker="The archive" heading="More episodes" width="wide">
        <div>
          {recent.map((entry, i) => (
            <EpisodeCard entry={entry} index={episodes.length - 1 - i} />
          ))}
        </div>
        <a
          href={url("/episodes")}
          class="kicker mt-6 inline-flex min-h-11 items-center text-ember underline-offset-4 hover:underline"
        >
          All episodes &rarr;
        </a>
      </Section>
    )
  }

  <Section variant="ink" kicker="Your hosts" heading="Two builders, one mic each" width="wide">
    <HostStrip />
  </Section>
</Layout>
