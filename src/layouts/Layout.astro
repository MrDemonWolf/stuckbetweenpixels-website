---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import socialShare from "../assets/brand/default-social-share.jpg";
import ConsentBanner from "../components/ConsentBanner.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import StickyPlayer from "../components/StickyPlayer.astro";

interface Props {
	title?: string;
	description?: string;
	/** Absolute or root-relative image for OG/Twitter cards. Defaults to the brand card. */
	image?: string;
	/** "website" for pages, "article" for episodes. */
	ogType?: string;
	/** Keep thin/duplicate pages (e.g. /design-system) out of the index. */
	noindex?: boolean;
	/** JSON-LD object serialized into a ld+json script. */
	schema?: Record<string, unknown>;
}

const SITE_NAME = "Stuck Between Pixels";

const {
	title = SITE_NAME,
	description = "A podcast about web development, DevOps, AI, business development, and professional networking in tech.",
	image = socialShare.src,
	ogType = "website",
	noindex = false,
	schema,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const ogImage = new URL(image, Astro.site ?? Astro.url.origin);
const gaId = import.meta.env.PUBLIC_GA_ID;

import { url } from "../lib/url";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href={url("/favicon.png")} />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${SITE_NAME} episodes`}
      href={url("/rss.xml")}
    />

    {schema && <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />}

    <ClientRouter />
    {/* No-flash theme resolve — must run before first paint. Explicit choice
       (sbp-theme) wins; otherwise follow the OS. Kept in sync with the toggle
       in ThemeToggle.astro and the --sbp-* tokens in global.css.

       data-cfasync="false" opts this out of Cloudflare Rocket Loader, which is
       enabled on the zone and defers scripts until after render. Deferring this
       one reintroduces exactly the flash-of-wrong-theme it exists to prevent,
       and delays the `.js` class that arms `.js .reveal`. */}
    <script is:inline data-cfasync="false">
      (() => {
        const stored = localStorage.getItem("sbp-theme");
        const theme =
          stored ?? (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
        document.documentElement.dataset.theme = theme;
        // Arms the scroll-reveal hidden state. Without JS the class is never
        // added and `.js .reveal` never matches, so content stays visible.
        document.documentElement.classList.add("js");
      })();
    </script>
    {/* Analytics is consent-gated: gtag.js is NOT requested until the visitor
       accepts. Loading it first and asking afterwards would already have set
       cookies, which is the thing consent is supposed to prevent. The banner in
       ConsentBanner.astro calls window.sbpLoadAnalytics() on accept. */}
    {
      gaId && (
        <script is:inline data-cfasync="false" define:vars={{ gaId }}>
          window.sbpLoadAnalytics = () => {
            if (window.sbpAnalyticsLoaded) return;
            window.sbpAnalyticsLoaded = true;

            const s = document.createElement("script");
            s.async = true;
            s.src = "https://www.googletagmanager.com/gtag/js?id=" + gaId;
            document.head.appendChild(s);

            window.dataLayer = window.dataLayer || [];
            window.gtag = function () {
              window.dataLayer.push(arguments);
            };
            window.gtag("js", new Date());
            window.gtag("config", gaId);
          };

          if (localStorage.getItem("sbp-consent") === "granted") {
            window.sbpLoadAnalytics();
          }
        </script>
      )
    }
  </head>
  <body class="min-h-screen font-sans">
    <div id="page">
      <Header />
      <main>
        <slot />
      </main>
      <Footer />
    </div>
    {/* transition:persist lives on the root div inside StickyPlayer — see the
       note there for why it can't go on the component. */}
    <StickyPlayer />
    {gaId && <ConsentBanner />}

    <script>
      // Scroll reveal. `.reveal` starts hidden in CSS, so if this never runs the
      // content would be invisible — bail by revealing everything instead.
      function initReveal() {
        const items = document.querySelectorAll<HTMLElement>(".reveal:not(.is-visible)");
        if (!items.length) return;

        if (
          !("IntersectionObserver" in window) ||
          matchMedia("(prefers-reduced-motion: reduce)").matches
        ) {
          for (const el of items) el.classList.add("is-visible");
          return;
        }

        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              const el = entry.target as HTMLElement;
              // Stagger siblings so a list arrives as a cascade, not a slab.
              const siblings = Array.from(el.parentElement?.children ?? []);
              el.style.transitionDelay = `${Math.min(siblings.indexOf(el), 6) * 60}ms`;
              el.classList.add("is-visible");
              observer.unobserve(el);
            }
          },
          { rootMargin: "0px 0px -10% 0px", threshold: 0.05 },
        );

        for (const el of items) observer.observe(el);
      }

      initReveal();
      document.addEventListener("astro:page-load", initReveal);
    </script>
  </body>
</html>
