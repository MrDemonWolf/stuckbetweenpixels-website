---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import socialShare from "../assets/brand/default-social-share.jpg";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import StickyPlayer from "../components/StickyPlayer.astro";

interface Props {
	title?: string;
	description?: string;
	/** Absolute or root-relative image for OG/Twitter cards. Defaults to the brand card. */
	image?: string;
	/** "website" for pages, "article" for episodes. */
	ogType?: string;
	/** Keep thin/duplicate pages (e.g. /design-system) out of the index. */
	noindex?: boolean;
	/** JSON-LD object serialized into a ld+json script. */
	schema?: Record<string, unknown>;
}

const SITE_NAME = "Stuck Between Pixels";

const {
	title = SITE_NAME,
	description = "A podcast about web development, DevOps, business development, and professional networking in tech.",
	image = socialShare.src,
	ogType = "website",
	noindex = false,
	schema,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const ogImage = new URL(image, Astro.site ?? Astro.url.origin);
const gaId = import.meta.env.PUBLIC_GA_ID;

import { url } from "../lib/url";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href={url("/favicon.png")} />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${SITE_NAME} episodes`}
      href={url("/rss.xml")}
    />

    {schema && <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />}

    <ClientRouter />
    {/* No-flash theme resolve — must run before first paint. Explicit choice
       (sbp-theme) wins; otherwise follow the OS. Kept in sync with the toggle
       in ThemeToggle.astro and the --sbp-* tokens in global.css. */}
    <script is:inline>
      (() => {
        const stored = localStorage.getItem("sbp-theme");
        const theme =
          stored ?? (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
        document.documentElement.dataset.theme = theme;
      })();
    </script>
    {
      gaId && (
        <>
          <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`} />
          <script is:inline define:vars={{ gaId }}>
            window.dataLayer = window.dataLayer || [];
            function gtag() {
              dataLayer.push(arguments);
            }
            gtag("js", new Date());
            gtag("config", gaId);
          </script>
        </>
      )
    }
  </head>
  <body class="min-h-screen font-sans">
    <div id="page">
      <Header />
      <main class="pb-24">
        <slot />
      </main>
      <Footer />
    </div>
    <StickyPlayer transition:persist />
  </body>
</html>
